#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT=development

# TODO (PRE-PRODUCTION): Rotate all secrets before go-live.
# Rotate SMTP, Authorize.Net (prod), Duo, DB credentials, and encryption keys.
# Do not deploy to production until all production secrets are rotated and updated.

#--------------------------------------------------------------------
# AUTHORIZE.NET
#--------------------------------------------------------------------

# Mode: auto | sandbox | production
# auto => sandbox in development/testing, production in CI_ENVIRONMENT=production
ANET_MODE=auto

# Sandbox credentials (used automatically in development/testing with ANET_MODE=auto)
ANET_SANDBOX_API_LOGIN_ID=encentallc9793
ANET_SANDBOX_TRANSACTION_KEY=748Kt6BBg75Ngk7b
ANET_SANDBOX_SIGNATURE_KEY=748Kt6BBg75Ngk7b

# Production credentials (used automatically in CI_ENVIRONMENT=production with ANET_MODE=auto)
ANET_PRODUCTION_API_LOGIN_ID=encentallc9793
ANET_PRODUCTION_TRANSACTION_KEY=748Kt6BBg75Ngk7b
ANET_PRODUCTION_SIGNATURE_KEY=748Kt6BBg75Ngk7b

# Legacy fallback vars (optional, for backward compatibility only)
# ANET_API_LOGIN_ID=
# ANET_TRANSACTION_KEY=
# ANET_SIGNATURE_KEY=

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL=https://spark-awards-competition.local/
app.forceGlobalSecureRequests=true
app.CSRFProtection=true
app.CSPEnabled=false

#--------------------------------------------------------------------
# AUTH POLICY
#--------------------------------------------------------------------

# Toggle periodic password expiry enforcement.
AUTH_ENFORCE_PASSWORD_EXPIRY=true
# Expire passwords after this many months when enforcement is enabled.
AUTH_PASSWORD_EXPIRY_MONTHS=6
# Number of recent password hashes checked for reuse.
AUTH_PASSWORD_HISTORY_LIMIT=24

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname=localhost
database.default.database=sparkawards
database.default.username=user_sparkawards
database.default.password=pass_sparkawards
database.default.DBDriver=MySQLi
database.default.port=3306

#--------------------------------------------------------------------
# DUO
#--------------------------------------------------------------------

DUO_CLIENT_ID=DIQFT43A15CSYO12XL4L
DUO_CLIENT_SECRET=nxHtKY8bHeajD7HDKny0wtqxw8mHKepD5L7CM6I4
DUO_API_HOSTNAME=api-f61b9f54.duosecurity.com
DUO_REDIRECT_URI=https://spark-awards-competition.local/auth/2fa/callback

#--------------------------------------------------------------------
# ENCRYPTION
